<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="roscar">
  <xacro:arg name="laser_x" default="0.0"/>
  <xacro:arg name="laser_y" default="0.0"/>
  <xacro:arg name="laser_z" default="0.18"/>
  <xacro:arg name="laser_yaw" default="0.0"/>
  <xacro:arg name="imu_x" default="0.0"/>
  <xacro:arg name="imu_y" default="0.0"/>
  <xacro:arg name="imu_z" default="0.0"/>
  <xacro:arg name="imu_yaw" default="0.0"/>
  <xacro:arg name="camera_x" default="0.0"/>
  <xacro:arg name="camera_y" default="0.0"/>
  <xacro:arg name="camera_z" default="0.20"/>
  <xacro:arg name="camera_yaw" default="0.0"/>

  <link name="base_footprint"/>
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder radius="0.15" length="0.10"/></geometry>
      <material name="body"><color rgba="0.15 0.35 0.75 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder radius="0.15" length="0.10"/></geometry>
    </collision>
  </link>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
  </joint>

  <link name="base_laser"/>
  <joint name="base_laser_joint" type="fixed">
    <origin xyz="$(arg laser_x) $(arg laser_y) $(arg laser_z)"
            rpy="0 0 $(arg laser_yaw)"/>
    <parent link="base_link"/><child link="base_laser"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <origin xyz="$(arg imu_x) $(arg imu_y) $(arg imu_z)"
            rpy="0 0 $(arg imu_yaw)"/>
    <parent link="base_link"/><child link="imu_link"/>
  </joint>

  <!-- r200_link 之下的光学系(r200_*_optical_frame)由 r200_node 从 SDK 外参发布,
       不写入 URDF。 -->
  <link name="r200_link"/>
  <joint name="r200_joint" type="fixed">
    <origin xyz="$(arg camera_x) $(arg camera_y) $(arg camera_z)"
            rpy="0 0 $(arg camera_yaw)"/>
    <parent link="base_link"/><child link="r200_link"/>
  </joint>
</robot>
